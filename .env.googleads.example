# Copy to .env.googleads (git-ignored) and fill in. Never commit real values.
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
# The account to manage (10 digits, dashes optional)
GOOGLE_ADS_CUSTOMER_ID=
# Manager (MCC) account id that owns the developer token / has access to the account
GOOGLE_ADS_LOGIN_CUSTOMER_ID=

# Jarvis dashboard webhook (chattervane > app data panel)
JARVIS_WEBHOOK_URL=
# Optional: signs the body with HMAC-SHA256 in the X-Signature header
JARVIS_WEBHOOK_SECRET=

# Jarvis campaign feed file (written by python -m googleads.feed)
JARVIS_FEED_PATH=/home/sam/Projects/Jarvis/chattervane-ads-feed.json
JARVIS_FEED_KEY=google-app
# Optional: comma-separated campaign ids; empty = all App campaigns
JARVIS_FEED_CAMPAIGN_IDS=
